# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
NODE_ENV=production
PORT=3000
# مفتاح توقيع JWT — ولّد قيمة عشوائية طويلة (إلزامي)
JWT_SECRET=ضع_هنا_مفتاحاً_عشوائياً_طويلاً_وسرياً
JWT_EXPIRES=12h
BCRYPT_ROUNDS=12
# نطاق الواجهة المسموح (أو true للكل مؤقتاً)
CORS_ORIGIN=true
# مسار قاعدة البيانات (اتركه فارغاً للافتراضي)
# DB_PATH=/data/andlus.db
# كلمة مرور حساب المدير عند أول بذر (اختياري — الافتراضي Admin@123)
# ADMIN_PASSWORD=
# الرابط الأساسي للتطبيق (يُستخدم في روابط إعادة تعيين كلمة المرور)
# APP_BASE_URL=https://your-domain.up.railway.app
# إعدادات Brevo (مفضَّل — لا يتطلب ملكية دومين المستلم)
# BREVO_API_KEY=xkeysib-...
# BREVO_FROM=iibrahim@as.edu.sa        # بريد مُرسل موثَّق في Brevo
# BREVO_FROM_NAME=منصة الأندلس
# إعدادات Resend (بديل عبر HTTPS)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Training-hr@as.edu.sa   # يجب أن يكون نطاقاً موثَّقاً في Resend (أو onboarding@resend.dev للاختبار)
# إعدادات SMTP لإرسال بريد إعادة تعيين كلمة المرور (احتياطي إن لم تُضبط Resend)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
